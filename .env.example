# ───────────────
# Target Website
# ───────────────
URL_TARGET=https://docs.papermc.io/paper/dev/api/
CRAWL_SCOPE=domain

# ───────────────
# Worker Threads
# ───────────────
THREADS_WORKER=8

# ───────────────
# LLM Provider (choose ONE)
# Options: openai, gemini, anthropic, github
# ───────────────
LLM_PROVIDER=openai

# ───────────────
# API Keys (only the one for your provider is required)
# ───────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_API_KEY=

# ───────────────
# Output Directory
# ───────────────
KNOWLEDGE_NAME=knowledge_base.md
OUTPUT_DIR=./output
